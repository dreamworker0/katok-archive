# 빌드 산출물 (재생성 가능)
/site/
/hosting/
/firestore-payload/

# 비밀 — 절대 커밋 금지
# 서비스 계정 키는 다운로드 시 파일명이 제각각이라 넓게 잡는다
serviceAccountKey.json
*serviceaccount*.json
*service-account*.json
*adminsdk*.json
*-firebase-adminsdk-*
*.pem
*.p12
.env
.env.*

# 개인정보 — 멤버 이메일 명부
# (storage.rules 는 Custom Claims 로 옮긴 뒤 이메일이 없어져 추적 대상이 되었다)
/config/members.json

# 멤버가 낸 요청을 내려받은 것 (이메일 + 누가 무엇을 지우려는지)
/output/member-requests.json

# 제외 규칙 (운영 설정, 사람 이름 포함 가능)
/output/exclusions.json
/config/collection-policy.json

# 개인정보 가리기 예외 — 감추지 않을 연락처를 적는 곳이라 그 자체가 연락처 목록이다.
# (예시는 config/pii_allow.example.json)
/config/pii_allow.json

# 실패 알림 웹훅 — 주소를 아는 사람은 누구나 그 채널에 글을 쓸 수 있다.
# (예시는 config/notify.example.json)
/config/notify.json

# 태그 구름에서 뺄 지명·조직 이름 — 방에서 오간 특정 기관 목록이 된다.
# (예시는 config/tag_places.example.json)
/config/tag_places.json

# 의존성
node_modules/

# 파이썬 캐시
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Firebase CLI 캐시
/.firebase/

# Codex 격리 작업공간
/.worktrees/

# Superpowers 시각 브레인스토밍 임시 화면
/.superpowers/

# 카톡 내보내기 작업 폴더 (원본 대화 txt — 커밋하지 않음)
/inbox/*
!/inbox/README.md
/logs/

# 적재 대장 — "무엇을 이미 Firestore·Storage 에 올렸는가"의 로컬 캐시.
# 원격 상태를 비추는 것이라 커밋할 값이 아니다. 없으면 다음 실행이 전량으로 돈다.
/output/upload-state.json

# ---------------------------------------------------------------------------
# 대화 데이터 일체 — 이 저장소에 넣지 않는다 (2026-07-25 결정)
#
# 저장소는 '코드 백업'이다. 방에 오간 실명 대화와 사진은 36명의 개인정보이고,
# 협업자를 한 명 초대하는 순간 그 사람에게 방 전체가 열린다. 비공개 저장소라도
# 두지 않는 편이 맞다. 원본은 로컬 디스크에 있고, 발행본은 Firestore 에 있다.
#
# 이전에 올라갔던 이력은 git filter-repo 로 지우고 다시 올렸다.
/output/
/KakaoTalk_*.txt

# assets/ 아래는 통째로 무시한다 — 열거하지 않는다.
#
# 예전에는 하위 폴더를 하나씩 적었다: staging·design-source·files·images·thumbs·
# videos·[Kk]akao[Tt]alk_*. 그 방식이 이미 두 번 샜다. `/KakaoTalk_*.txt` 는 파일
# 하나만 잡아서 폴더째 내보낸 것이 그물을 빠져나갔고(실측 2026-07-27, 483MB·파일
# 309개), 폴더 이름이 'Chats'/'Chat' 으로 갈려 좁게 잡은 규칙이 또 빠져나갔다.
#
# 열거식은 새 폴더가 생길 때마다 다시 샌다. 그때 그 파일은 추적도 무시도 안 된
# 상태로 `git status` 에 떠 있고, `git add -A` 한 번에 들어간다 — 새는 곳이 공개
# 저장소라 되돌릴 수가 없다(이력을 지우고 다시 올려야 한다).
#
# 그래서 뒤집었다. 기본은 무시, 커밋할 것이 생기면 그때 예외를 적는다.
# `/inbox/*` + README 예외가 이미 이 방식이다.
# tests/test_repo_is_publishable.py 가 이 형태를 지킨다.
#
# 무엇이 들어 있는가 — 전부 대화 데이터이거나 그 파생물이다.
#   images/               사진 원본. 36명의 개인정보다.
#   videos/               동영상 원본. 같은 이유.
#   files/                공유된 첨부(문서·발표자료·zip, 84MB PDF 한 장 포함).
#                         저작물·내부 자료가 섞여 있다. 배포본은 Storage 로 올라가고
#                         목록은 output/files.jsonl 이 들고 있다.
#   thumbs/               갤러리용 작은 사진. build_thumbnails 로 다시 만든다.
#   staging/              수집 중간 덤프. 재수집 가능.
#   design-source/        화면 삽화 원본.
#   [Kk]akao[Tt]alk_*/    카톡이 폴더째 내보낸 것(대화 txt + 미디어 원본).
/assets/*
