# 빌드 산출물 (재생성 가능)
/site/
/hosting/
/firestore-payload/

# 사진 수집 중간 스테이징 (원본 다운로드 덤프, 재수집 가능)
/assets/staging/

# 비밀 — 절대 커밋 금지
# 서비스 계정 키는 다운로드 시 파일명이 제각각이라 넓게 잡는다
serviceAccountKey.json
*serviceaccount*.json
*service-account*.json
*adminsdk*.json
*-firebase-adminsdk-*
*.pem
*.p12
.env
.env.*

# 개인정보 — 멤버 이메일 명부와 그로부터 생성되는 규칙
/config/members.json
/storage.rules

# 제외 규칙 (운영 설정, 사람 이름 포함 가능)
/output/exclusions.json

# 의존성
node_modules/

# 파이썬 캐시
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Firebase CLI 캐시
/.firebase/
