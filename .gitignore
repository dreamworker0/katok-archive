# 빌드 산출물 (재생성 가능)
/site/
/hosting/
/firestore-payload/

# 사진 수집 중간 스테이징 (원본 다운로드 덤프, 재수집 가능)
/assets/staging/
/assets/design-source/

# 대화방에서 공유된 첨부 파일 원본.
# 사진(assets/images)과 달리 커밋하지 않는다 — 문서·발표자료·zip 이라 용량이 크고
# (84MB PDF 한 장 포함) 저작물·내부 자료가 섞여 있다. 배포본은 Storage 로 올라가고,
# 목록은 output/files.jsonl 이 들고 있으므로 git 이 원본을 보관할 이유가 없다.
/assets/files/

# 비밀 — 절대 커밋 금지
# 서비스 계정 키는 다운로드 시 파일명이 제각각이라 넓게 잡는다
serviceAccountKey.json
*serviceaccount*.json
*service-account*.json
*adminsdk*.json
*-firebase-adminsdk-*
*.pem
*.p12
.env
.env.*

# 개인정보 — 멤버 이메일 명부
# (storage.rules 는 Custom Claims 로 옮긴 뒤 이메일이 없어져 추적 대상이 되었다)
/config/members.json

# 멤버가 낸 요청을 내려받은 것 (이메일 + 누가 무엇을 지우려는지)
/output/member-requests.json

# 제외 규칙 (운영 설정, 사람 이름 포함 가능)
/output/exclusions.json
/config/collection-policy.json

# 개인정보 가리기 예외 — 감추지 않을 연락처를 적는 곳이라 그 자체가 연락처 목록이다.
# (예시는 config/pii_allow.example.json)
/config/pii_allow.json

# 태그 구름에서 뺄 지명·조직 이름 — 방에서 오간 특정 기관 목록이 된다.
# (예시는 config/tag_places.example.json)
/config/tag_places.json

# 의존성
node_modules/

# 파이썬 캐시
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Firebase CLI 캐시
/.firebase/

# Codex 격리 작업공간
/.worktrees/

# Superpowers 시각 브레인스토밍 임시 화면
/.superpowers/

# 카톡 내보내기 작업 폴더 (원본 대화 txt — 커밋하지 않음)
/inbox/*
!/inbox/README.md
/logs/

# 적재 대장 — "무엇을 이미 Firestore·Storage 에 올렸는가"의 로컬 캐시.
# 원격 상태를 비추는 것이라 커밋할 값이 아니다. 없으면 다음 실행이 전량으로 돈다.
/output/upload-state.json

# ---------------------------------------------------------------------------
# 대화 데이터 일체 — 이 저장소에 넣지 않는다 (2026-07-25 결정)
#
# 저장소는 '코드 백업'이다. 방에 오간 실명 대화와 사진은 36명의 개인정보이고,
# 협업자를 한 명 초대하는 순간 그 사람에게 방 전체가 열린다. 비공개 저장소라도
# 두지 않는 편이 맞다. 원본은 로컬 디스크에 있고, 발행본은 Firestore 에 있다.
#
# 이전에 올라갔던 이력은 git filter-repo 로 지우고 다시 올렸다.
/output/
/assets/images/
/KakaoTalk_*.txt
# 폴더째 내보낸 것 (대화 txt + 미디어 원본). 위 /KakaoTalk_*.txt 는 파일 하나만
# 잡아서 이 폴더들이 그물을 빠져나갔다.
#
# 이름을 넓게 잡는 이유: 카톡 내보내기 폴더명은 기기와 판마다 다르다. 실측 2026-07-27
# 하루에만 두 가지가 들어왔다 —
#   KakaoTalk_Chats_2026-07-27_16.27.33_-604971728        (43MB, 사진 77개)
#   Kakaotalk_Chat_바이브코딩,…_20260721_142500-…-1-001    (483MB, 파일 309개)
# 대소문자도 'Chats'/'Chat' 도 달랐다. 좁게 잡으면 다음 폴더가 또 빠져나간다.
/assets/[Kk]akao[Tt]alk_*/

# 갤러리용 작은 사진 — 원본에서 다시 만들 수 있는 파생물이다.
# (python -m scripts.build_thumbnails)
/assets/thumbs/

# 동영상 원본 — 대화 데이터다(assets/images 와 같은 이유로 커밋하지 않는다).
/assets/videos/
