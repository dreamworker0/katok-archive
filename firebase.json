  ],
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "*.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "node scripts/test_rules.js"
    ]
  },
  "storage": {
